{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "jsx": "react-jsx",

        "allowJs": true,
        "checkJs": false,

        "paths": {
            "@/*": [
                "./resources/js/*"
            ]
        }
    },

    "include": [
        "resources/js/**/*"
    ],

    "exclude": [
        "node_modules",
        "vendor",
        "public"
    ]
}